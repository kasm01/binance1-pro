After=network-online.target redis-server.service binance1-central-risk-shadow.service

[Service]
Type=simple
WorkingDirectory=/home/kasm920/binance1-pro
EnvironmentFile=-/home/kasm920/binance1-pro/.env
EnvironmentFile=-/home/kasm920/binance1-pro/.runtime_secrets.env
ExecStart=/home/kasm920/venv/bin/python -u /home/kasm920/binance1-pro/scripts/central_risk_enforce_dry_service.py
